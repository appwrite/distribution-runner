# Owned by the image. Run with the working directory set to the directory that holds
# this fastlane/ folder, never inside the checkout: fastlane only looks for
# ./fastlane/Fastfile, ./.fastlane/Fastfile and ./Fastfile relative to the working directory.
skip_docs
opt_out_usage

platform :android do
  lane :build do
    source = File.realpath(ENV.fetch('DISTRIBUTION_SOURCE'))
    root = File.expand_path(ENV.fetch('DISTRIBUTION_ROOT_DIRECTORY'), source)
    root = File.join(root, 'android') if ENV['DISTRIBUTION_FRAMEWORK'] == 'react-native'
    UI.user_error!('root directory escapes the checkout') unless root == source || root.start_with?(source + File::SEPARATOR)
    Dir.chdir(root) do
      sh(ENV.fetch('DISTRIBUTION_BUILD_COMMAND'))
    end
  end
end
